# Trading Signal
# Sao chep file nay thanh .env, sau do dien gia tri can dung.
# Khong chia se hoac commit file .env.

# Cong chay giao dien web (mac dinh: 3210)
PORT=3210

# Chi cho phep truy cap tu may dang chay tool (khuyen nghi).
# Khi trien khai sau reverse proxy co xac thuc moi doi thanh 0.0.0.0.
HOST=127.0.0.1

# Thu muc du lieu runtime. De trong se dung ./data trong thu muc ung dung.
# Tren Linux nen dung mot duong dan ben ngoai source, vi du:
# DATA_DIR=/var/lib/trading-signal
DATA_DIR=

# Bat buoc khi NODE_ENV=production. Chay `npm run generate-auth` de tao 4 dong nay.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_HOURS=12

# Dang duoc su dung: bat buoc neu quet DEX khung W1.
# DEX D1 va du lieu Spot cong khai cua 7 san CEX khong can API key.
COINGECKO_API_KEY=

# De san cho giai doan tich hop du lieu chung khoan Viet Nam.
# Chua duoc su dung trong phien ban hien tai.
SSI_API_KEY=
SSI_API_SECRET=

# Telegram Bot gui canh bao tu dong.
# TELEGRAM_BOT_TOKEN lay tu @BotFather. Chat ID co the de trong va tim tren giao dien.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Read-only API of metals-data-collector on the same VPS.
METALS_API_URL=http://127.0.0.1:8787/
