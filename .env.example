# Trading Signal v3.3.0
# Copy this file to .env and fill in production/local values.
# Never commit the real .env file.

PORT=3210
HOST=127.0.0.1

# Runtime data. On VPS, keep this outside the source tree.
# Example: DATA_DIR=/var/lib/trading-signal
DATA_DIR=

# Required when NODE_ENV=production. Generate with: npm run generate-auth
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_HOURS=12

# Optional/required only for features that use it.
COINGECKO_API_KEY=

# Local read-only market-data services.
STOCKS_API_URL=http://127.0.0.1:8790/
METALS_API_URL=http://127.0.0.1:8787/

# Telegram automation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
